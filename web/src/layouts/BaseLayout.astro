---
interface Props {
	cssFile?: string;
	title?: string;
	description?: string;
}

const { cssFile, title = "Animedle", description = "Reto diario de adivinar anime" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="stylesheet" href={cssFile}>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Gabarito:wght@400..900&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--sl-color-accent: 124, 58, 237;
		--sl-color-accent-high: 138, 92, 246;
		--sl-color-accent-low: 109, 40, 217;
		--sl-color-white: 255, 255, 255;
		--sl-color-gray-1: 238, 241, 248;
		--sl-color-gray-2: 198, 203, 221;
		--sl-color-gray-3: 149, 157, 185;
		--sl-color-gray-4: 99, 108, 137;
		--sl-color-gray-5: 61, 68, 93;
		--sl-color-gray-6: 36, 40, 57;
		--sl-color-black: 23, 25, 35;
		--sl-color-bg: var(--sl-color-black);
		
		--accent-gradient: linear-gradient(
			135deg,
			rgb(var(--sl-color-accent-low)),
			rgb(var(--sl-color-accent)) 50%,
			rgb(var(--sl-color-accent-high))
		);
	}
	
	* {
		box-sizing: border-box;
		margin: 0;
		font-family: gabarito;
	}
	
	html {
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
		background: rgb(var(--sl-color-bg));
		color: rgb(var(--sl-color-gray-1));
		line-height: 1.6;
	}
	
	body {
		margin: 0;
		min-height: 100vh;
	}
	
	code {
		font-family: 'Courier New', Courier, monospace;
		background: rgb(var(--sl-color-gray-6));
		padding: 0.125rem 0.375rem;
		border-radius: 0.25rem;
		font-size: 0.9em;
	}
	
	a {
		color: rgb(var(--sl-color-accent-high));
		text-decoration: none;
	}
</style>

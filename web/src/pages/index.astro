---
import { Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import ChallengeInfo from "../layouts/ChallengeInfo.astro";

import anime from "../assets/anime.svg";
import personaje from "../assets/personaje.svg";
import emoji from "../assets/emoji.svg";
import opening from "../assets/opening.svg";
import github from "../assets/github.svg";

import "../styles/index.css";
---

<BaseLayout
  title="Animedle - Reto diario de adivinar anime"
>
<main>
    <div class="hero">
        <h1>Animedle</h1>
    </div>

    <section class="challenge_button_main">
        <ChallengeInfo
            challengeName='anime'
            image={anime}
            destination="/anime"
            size='70'
            title='Anime'
            description='Adivina con 4 fotos'
        />

        <ChallengeInfo
            challengeName='personaje'
            image={personaje}
            destination="/character"
            size='70'
            title='Personaje'
            description='Adivina con un personaje'
        />

        <ChallengeInfo
            challengeName='emoji'
            image={emoji}
            destination="/emoji"
            size='70'
            title='Emojis'
            description='Adivina con 5 emojis'
        />

        <ChallengeInfo
            challengeName='opening'
            image={opening}
            destination="/opening"
            size='70'
            title='Opening'
            description='Adivina con 5 segundos de opening'
        />
    </section>

    <div class="api_info_menu">
        <a class="api_github_href_menu" href="https://github.com/WysperOtaku/Animedle">
            <Image class="api_github_menu" src={github} alt="Github Repository" />
        </a>
        <a class="api_h3_menu" href="/how-it-works">API Docs</a>
    </div>
</main>
</BaseLayout>
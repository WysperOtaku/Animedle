---
import { Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import ChallengeButtonContainer from '../layouts/ChallengeButtonContainer.astro';

import github from "../assets/github.svg";

import "../styles/global.css";
---

<BaseLayout
  title="Animedle - Reto diario de adivinar anime"
>
<main>
    <div class="hero">
        <h1>Animedle</h1>
    </div>

    <ChallengeButtonContainer />

    <div id="clues" class="clues">
        
    </div>

    <input class="guess_input" type="text" placeholder="Introduce anime...">

    <button id="submit_guess" class="guess_button">Make a guess</button>
</main>

<div class="api_info">
    <a class="api_github_href" href="https://github.com/WysperOtaku/Animedle">
        <Image class="api_github" src={github} alt="Github Repository" />
    </a>
    <a class="api_h3" href="/how-it-works">API Docs</a>
</div>
</BaseLayout>

<script>
    import { getChallenge } from "../types/loadChallenges";

    const clues = document.getElementById("clues");
    const apiUrl = import.meta.env.PUBLIC_BASE_URL;
    const dailyInfo = await getChallenge('personaje');
  
    const tag = document.createElement("img");
    const atributes = `${apiUrl}/${(dailyInfo?.datos as PersonajeData).personaje}`;

    tag.setAttribute("src", atributes);
    tag.setAttribute("alt", "Pista para personaje");
    clues!.appendChild(tag);

    const submitButton = document.getElementById("submit_guess");
    const inputGuess = document.querySelector(".guess_input") as HTMLInputElement;

    submitButton?.addEventListener("click", () => {
        const userGuess = inputGuess.value.trim().toLowerCase();
        const correctAnswer = dailyInfo?.name.toLowerCase();
        
        const normalize = (str: string) => str
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/[^a-z0-9]/g, "");
        
        const normalizedGuess = normalize(userGuess);
        const normalizedAnswer = normalize(correctAnswer || "");
        
        // Crear regex flexible: permite que falten hasta 2 caracteres o estén en diferente orden
        const pattern = normalizedAnswer.split("").join(".*?");
        const regex = new RegExp(pattern, "i");
        
        // Comprobar si la respuesta es correcta (exacta o muy similar)
        const isExactMatch = normalizedGuess === normalizedAnswer;
        const isSimilar = regex.test(normalizedGuess) && 
                         normalizedGuess.length >= normalizedAnswer.length * 0.7;
        
        if (isExactMatch || isSimilar) {
            alert("¡Correcto! 🎉");
        } else {
            alert("Incorrecto, intenta de nuevo 😢");
        }
    });
</script>
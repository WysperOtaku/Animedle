---
import { Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import ChallengeButtonContainer from '../layouts/ChallengeButtonContainer.astro';

import github from '../assets/github.svg';

import '../styles/global.css';
---

<BaseLayout
  title="Animedle - Reto diario de adivinar anime"
>
  <main>
    <div class="hero">
      <h1>Animedle</h1>
    </div>

    <ChallengeButtonContainer />

    <div id="clues" class="clues"></div>

    <div class="navigation_buttons">
      <button id="prev_clue" class="nav_button"
        >← Pista anterior</button
      >
      <button id="next_clue" class="nav_button"
        >Pista siguiente →</button
      >
    </div>

    <input
      class="guess_input"
      type="text"
      placeholder="Introduce anime..."
    />

    <button id="submit_guess" class="guess_button"
      >Make a guess</button
    >
  </main>

  <div class="api_info">
    <a
      class="api_github_href"
      href="https://github.com/WysperOtaku/Animedle"
    >
      <Image
        class="api_github"
        src={github}
        alt="Github Repository"
      />
    </a>
    <a class="api_h3" href="/how-it-works">API Docs</a>
  </div>
</BaseLayout>

<script>
  import { getChallenge } from '../types/loadChallenges';

  const clues = document.getElementById('clues');
  const apiUrl = import.meta.env.PUBLIC_BASE_URL;
  const dailyInfo = await getChallenge('imagenes');

  const difficultyLevels = [
    'hard',
    'medium',
    'easy',
    'very_easy'
  ] as const;
  let currentDifficultyIndex = 0;
  let maxDifficultyIndexSeen = 0;

  const imageTag = document.createElement('img');
  imageTag.setAttribute('alt', 'Pista para anime');
  clues!.appendChild(imageTag);

  function updateImage(difficultyIndex: number) {
    if (difficultyIndex >= difficultyLevels.length) {
      difficultyIndex = difficultyLevels.length - 1;
    }

    if (difficultyIndex > maxDifficultyIndexSeen) {
      maxDifficultyIndexSeen = difficultyIndex;
    }

    const currentLevel = difficultyLevels[difficultyIndex];
    const imageData = dailyInfo?.datos as ImagenesData;
    const imageUrl = `${apiUrl}${imageData[currentLevel]}`;

    imageTag.setAttribute('src', imageUrl);
  }

  function updateNavigationButtons() {
    const prevButton = document.getElementById(
      'prev_clue'
    ) as HTMLButtonElement;
    const nextButton = document.getElementById(
      'next_clue'
    ) as HTMLButtonElement;

    if (prevButton) {
      prevButton.disabled = currentDifficultyIndex === 0;
    }
    if (nextButton) {
      nextButton.disabled =
        currentDifficultyIndex >=
        difficultyLevels.length - 1;
    }
  }

  updateImage(currentDifficultyIndex);
  updateNavigationButtons();

  document
    .getElementById('prev_clue')
    ?.addEventListener('click', () => {
      if (currentDifficultyIndex > 0) {
        currentDifficultyIndex--;
        updateImage(currentDifficultyIndex);
        updateNavigationButtons();
      }
    });

  document
    .getElementById('next_clue')
    ?.addEventListener('click', () => {
      if (
        currentDifficultyIndex <
        difficultyLevels.length - 1
      ) {
        currentDifficultyIndex++;
        updateImage(currentDifficultyIndex);
        updateNavigationButtons();
      }
    });

  const submitButton =
    document.getElementById('submit_guess');
  const inputGuess = document.querySelector(
    '.guess_input'
  ) as HTMLInputElement;

  submitButton?.addEventListener('click', () => {
    const userGuess = inputGuess.value.trim().toLowerCase();
    const correctAnswer = dailyInfo?.name.toLowerCase();

    const normalize = (str: string) =>
      str
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]/g, '');

    const normalizedGuess = normalize(userGuess);
    const normalizedAnswer = normalize(correctAnswer || '');

    // Crear regex flexible: permite que falten hasta 2 caracteres o estén en diferente orden
    const pattern = normalizedAnswer.split('').join('.*?');
    const regex = new RegExp(pattern, 'i');

    // Comprobar si la respuesta es correcta (exacta o muy similar)
    const isExactMatch =
      normalizedGuess === normalizedAnswer;
    const isSimilar =
      regex.test(normalizedGuess) &&
      normalizedGuess.length >=
        normalizedAnswer.length * 0.7;

    if (isExactMatch || isSimilar) {
      const easiestClueUsed =
        difficultyLevels[maxDifficultyIndexSeen];
      alert(
        `¡Correcto! 🎉 Lo resolviste con la pista: ${easiestClueUsed}`
      );
    } else {
      alert('Incorrecto, intenta de nuevo 😢');

      currentDifficultyIndex++;
      if (
        currentDifficultyIndex < difficultyLevels.length
      ) {
        updateImage(currentDifficultyIndex);
        updateNavigationButtons();
      } else {
        alert('Ya no hay más pistas disponibles 😔');
      }
    }

    inputGuess.value = '';
  });
</script>
